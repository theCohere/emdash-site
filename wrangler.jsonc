{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-site","database_id": "52fb9bef-1a67-4e36-9183-e86df135d1ac",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-media","preview_bucket_name": "emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
    // 添加 send_email 绑定
  	"send_email": [
   	 	{
      		"name": "EMAIL",
      		"allowed_destination_addresses": [] 
    	}
  	],
    "vars": {
   		 "EMAIL_FROM": "noreply@thecohere.org"
    }
}
